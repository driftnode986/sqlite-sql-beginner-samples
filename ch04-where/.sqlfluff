[sqlfluff]
# repo 直下の .sqlfluff の除外（AM04・LT09）に足す。どれも第4章でわざと見せる書き方。
# AM09: LIMIT を ORDER BY（第5章）より先に使う（第3章と同じ）。
# CV05: = NULL が効かないことを実行して見せる（04-23・04-26）。正しい IS NULL は 04-24・04-25。
# ST10: 値と値を直接比べて、比べた結果が 1 か 0 になるのを見せる（04-15・04-20・04-27）。
# RF05: 04-23 の別名 "= NULL" "IS NULL" は、結果の見出しに比べ方そのものを出すため。
exclude_rules = AM04, LT09, AM09, CV05, ST10, RF05
